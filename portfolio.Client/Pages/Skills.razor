@page "/skills"
<PageTitle>Engineering approach</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="home-shell engineering-page">
    <MudText Typo="Typo.overline" Class="eyebrow">How I work</MudText>
    <MudText Typo="Typo.h3" Class="engineering-title">Engineering approach</MudText>
    <MudText Typo="Typo.body1" Class="engineering-intro">
        I try to make implementation choices clear, testable, and proportionate to the problem.
        These are the practices I am applying in the projects shown here.
    </MudText>

    <MudGrid Spacing="3" Class="engineering-grid">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="principle-card pa-5">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.h6" Class="principle-title">Keep boundaries clear</MudText>
                <MudText Typo="Typo.body2" Class="principle-copy">
                    Separate the user interface, API, and deployment responsibilities so each part has a clear job.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="principle-card pa-5">
                <MudIcon Icon="@Icons.Material.Filled.Rule" Color="Color.Primary" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.h6" Class="principle-title">Test behavior that matters</MudText>
                <MudText Typo="Typo.body2" Class="principle-copy">
                    Use focused tests and automated checks to make changes safer to review and release.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="principle-card pa-5">
                <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Primary" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.h6" Class="principle-title">Match cost to need</MudText>
                <MudText Typo="Typo.body2" Class="principle-copy">
                    Keep the current demos on free hosting and state their limitations before adding services with ongoing cost.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Outlined="true" Class="stack-panel pa-5 pa-md-6">
        <MudText Typo="Typo.h6" Class="principle-title">Tools used in the featured projects</MudText>
        <MudText Typo="Typo.body2" Class="principle-copy mb-3">
            The tools below are demonstrated in the repositories linked from this portfolio.
        </MudText>
        <div class="stack-chips" aria-label="Technologies used in featured projects">
            @foreach (var technology in Technologies)
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@technology</MudChip>
            }
        </div>
    </MudPaper>
</MudContainer>

@code {
    private static readonly string[] Technologies =
    [
        "C#", ".NET 10", "ASP.NET Core", "React", "TypeScript", "Vite",
        "Blazor WebAssembly", "AWS Lambda", "API Gateway", "GitHub Actions", "Vitest", "xUnit"
    ];
}
