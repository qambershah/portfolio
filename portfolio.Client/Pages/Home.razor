@page "/"
<PageTitle>Welcome</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <!-- Profile Section -->
    <MudPaper Elevation="1" Class="profile-card d-flex flex-column align-items-start mb-6 pa-4">

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
            <MudAvatar Size="Size.Large">
                <MudImage Src="images/avatar.jpeg" Alt="An image of my avatar!"></MudImage>
            </MudAvatar>

            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">Qamber Abbas</MudText>
                <MudText Typo="Typo.subtitle1" Class="text-muted">Fullstack Developer</MudText>
            </MudStack>
        </MudStack>

        <MudText Typo="Typo.body1" Class="mb-3">
            I’m a full-stack developer working with C#, .NET, React, and TypeScript. I use this portfolio to share projects and the tools behind them.
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-3">
            My projects include a Blazor portfolio and a threaded comments app with a React frontend and .NET API.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="projects" Class="mb-4">
            View projects
        </MudButton>

        <!-- Contact Buttons -->
        <MudStack Row="true" Spacing="2" Class="mb-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Email" Href="mailto:qamber9abbas@gmail.com" Target="_blank">
                Email Me
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Custom.Brands.GitHub" Href="https://github.com/qambershah" Target="_blank">
                GitHub
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Custom.Brands.LinkedIn" Href="https://linkedin.com/in/qamber9abbas" Target="_blank">
                LinkedIn
            </MudButton>
        </MudStack>

        @* <MudButton Variant="Variant.Filled" Color="Color.Success" Href="files/QamberShah_Resume.pdf" Target="_blank" StartIcon="@Icons.Material.Filled.Download">
            Download Resume
        </MudButton> *@
    </MudPaper>

    <!-- Footer -->
    <MudText Typo="Typo.caption" Class="text-muted mt-4">
        💡 Built with Blazor WebAssembly + MudBlazor, powered by GitHub Actions and deployed on GitHub Pages.
    </MudText>

</MudContainer>
