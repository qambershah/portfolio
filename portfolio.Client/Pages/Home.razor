@page "/"
@inject JsonProjectService ProjectService

<PageTitle>Qamber Abbas | Software Engineer</PageTitle>

<header class="intro">
    <h1>Qamber Abbas</h1>
    <p class="role">Software Engineer · Melbourne</p>
    <p>
        I build backend services and web applications with C#, .NET and SQL Server, with Angular or Blazor
        on the front end. I've worked on HR and payroll software, internal business systems, and
        now reporting services in wealth management.
    </p>
    <nav class="links" aria-label="Contact">
        <a href="https://github.com/qambershah" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/qamber9abbas" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:qamber9abbas@gmail.com">Email</a>
    </nav>
</header>

<section aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <ol class="entries">
        @foreach (var role in Roles)
        {
            <li class="entry">
                <div class="entry-head">
                    <h3>@role.Title <span class="muted">· @role.Company</span></h3>
                    <span class="muted dates">@role.Dates</span>
                </div>
                @if (!string.IsNullOrEmpty(role.Summary))
                {
                    <p>@role.Summary</p>
                }
            </li>
        }
    </ol>
</section>

<section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    @if (_projects is null && _loadError is null)
    {
        <p class="muted">Loading projects…</p>
    }
    else if (_loadError is not null)
    {
        <p class="muted">@_loadError</p>
    }
    else
    {
        <ol class="entries">
            @foreach (var project in _projects!)
            {
                <li class="entry">
                    <h3>@project.Title</h3>
                    <p>@project.Description</p>
                    @if (!string.IsNullOrEmpty(project.Note))
                    {
                        <p class="muted">@project.Note</p>
                    }
                    <p class="muted tech">@string.Join(" · ", project.Technologies)</p>
                    <p class="links">
                        @if (!string.IsNullOrEmpty(project.Link))
                        {
                            <a href="@project.Link" target="_blank" rel="noopener">Live demo</a>
                        }
                        @if (!string.IsNullOrEmpty(project.Github))
                        {
                            <a href="@project.Github" target="_blank" rel="noopener">Source</a>
                        }
                    </p>
                </li>
            }
        </ol>
    }
</section>

<footer class="muted">
    This site is a Blazor WebAssembly app on .NET 10. <a href="https://github.com/qambershah/portfolio" target="_blank" rel="noopener">Source</a>
</footer>

@code {
    private sealed record Role(string Title, string Company, string Dates, string? Summary = null);

    // Keep summaries short and factual. Add measured outcomes only where they can be shared.
    private static readonly Role[] Roles =
    [
        new("Software Engineer", "Netwealth", "Jul 2025 – present",
            "C# and .NET services in the reporting domain of a wealth-management platform."),
        new("Full Stack Developer", "A.G. Coombs", "Aug 2024 – Feb 2025",
            "Built an internal eProcurement application with Blazor Server, .NET, EF Core and SQL Server, and migrated .NET Framework APIs to .NET 6."),
        new("Full Stack Developer (contract)", "Cancer Council Victoria", "Jan 2023 – Jan 2024"),
        new("Software Engineer", "Inzenius", "Oct 2018 – Jan 2023"),
        new("Software Engineer (internship)", "OnePassport", "Feb 2018 – May 2018"),
    ];

    private List<ProjectModel>? _projects;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await ProjectService.GetProjectsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadError = "Projects could not be loaded. Refresh the page to try again.";
        }
    }
}
